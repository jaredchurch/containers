# Use the official Python 3.10 image built on Debian Trixie Slim
FROM mcr.microsoft.com/devcontainers/python:3.10-trixie

LABEL org.opencontainers.image.source="https://github.com/jaredchurch/containers"
LABEL org.opencontainers.image.licenses="MIT"

# Prevent Python from writing .pyc files to disk
ENV PYTHONDONTWRITEBYTECODE=1

# Prevent Python from buffering stdout and stderr
ENV PYTHONUNBUFFERED=1

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get -y install --no-install-recommends \
      nodejs \
      npm \
      curl \
      wget \
      gnupg \
      unzip \
      sudo \
      ssh \
      locales \
    && apt-get clean \
    && sed -i -e 's/# en_NZ.UTF-8 UTF-8/en_NZ.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*


# Install PowerShell from the Microsoft repository
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
      | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/microsoft-debian-bookworm-prod bookworm main" \
      > /etc/apt/sources.list.d/microsoft.list \
    && apt-get update \
    && apt-get -y install --no-install-recommends powershell \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI from the official repository
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get -y install --no-install-recommends gh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CE (engine + CLI) from the official repository for Docker-in-Docker support
RUN curl -fsSL https://download.docker.com/linux/debian/gpg \
      | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian trixie stable" \
      > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get -y install --no-install-recommends \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
        erofs-utils \
    && apt-mark hold docker-ce docker-ce-cli \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Disable the containerd erofs snapshotter to avoid dockerd startup timeouts on
# hosts whose kernel advertises the erofs filesystem
# (see https://github.com/devcontainers/features/issues/1642)
RUN mkdir -p /etc/containerd \
    && containerd config default > /etc/containerd/config.toml \
    && sed -i 's/^disabled_plugins = \[\]/disabled_plugins = ["io.containerd.snapshotter.v1.erofs"]/' /etc/containerd/config.toml

# Allow the devcontainer user to talk to the Docker daemon.
# Pin the docker group GID to 1001 so it matches the host docker group
# (and any group-mapped mounts) reliably.
RUN if grep -q "^docker:" /etc/group; then \
        groupmod -g 1001 docker; \
    else \
        groupadd -g 1001 docker; \
    fi \
    && usermod -aG docker vscode

# docker-init.sh starts dockerd (and containerd) and is picked up automatically
# by dev container tooling as the container init script
COPY ./docker-init.sh /usr/local/share/docker-init.sh
RUN chmod +x /usr/local/share/docker-init.sh

RUN curl https://bws.bitwarden.com/install | sh

RUN mkdir -p "$HOME/.config/Bitwarden CLI" \
    && touch "$HOME/.config/Bitwarden CLI/data.json" \
    && wget "https://vault.bitwarden.com/download/?app=cli&platform=linux" --quiet -O /tmp/bw.zip \
    && unzip /tmp/bw.zip \
    && mv -f ./bw /usr/local/bin/bw \
    && rm -f /tmp/bw.zip

# allow users to read the root home directory, which is required for devpods to work properly (setting github user info)
RUN chmod a+rx /root

# Add the user to the sudo group
RUN usermod -aG sudo vscode && \
    echo "vscode ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER vscode


### End of File